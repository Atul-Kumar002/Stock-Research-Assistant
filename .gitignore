# Virtual environments
.venv/
venv/
env/
ENV/

# ============================================================
# Environment variables & secrets  ← NEVER commit these
# ============================================================
.env
.env.local
.env.production
.env.development
.env.staging
.env.test
*.local.env
# Allow the example template through
!.env.example
!**/.env.example

# ============================================================
# Databases & local state
# ============================================================
*.db
*.sqlite
*.sqlite3

# ============================================================
# Node / JavaScript
# ============================================================
node_modules/
.npm/
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output — excluded by default
.build/
out/
.output/
# frontend/dist is the deployable artifact for Vercel (no build step)
# so it IS tracked. Only exclude other dist folders:
backend/dist/

# Astro
.astro/

# ============================================================
# Logs
# ============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Scratch / temporary work files
# ============================================================
scratch/

# ============================================================
# Misc
# ============================================================
coverage/
.cache/
tmp/
temp/
